# Copy to .env and fill in. .env is git- and docker-ignored: never commit it.
# Used by docker compose and by local runs (config.py reads it; real
# environment variables take precedence).

# Required for the paid-tier AI Action Plan. Keep it secret.
ANTHROPIC_API_KEY=

# Optional tuning (defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5    # e.g. claude-sonnet-5 or claude-opus-5 for stronger analysis
# AGENT_EFFORT=low                    # low | medium | high; ignored by Haiku 4.5
# AGENT_FALLBACKS=1                   # server-side refusal fallback (Opus 5 / Fable 5 only)
# MONTHLY_TOKEN_LIMIT=5000            # per paid user per calendar month (UTC)
# AGENT_MAX_OUTPUT_TOKENS=1200
# AGENT_MIN_OUTPUT_TOKENS=600         # refuse to start a report that cannot finish
# SESSION_IDLE_MINUTES=60
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# STOCKERA_DATA_DIR=./data            # where stockera.db lives
# STOCKERA_PORT=8501                  # host port for docker compose
